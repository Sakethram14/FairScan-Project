rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 's.sakethram14@gmail.com';
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'fullName']) &&
             data.email is string && data.email.size() <= 256 &&
             data.fullName is string && data.fullName.size() <= 256 &&
             (data.get('organization', '') is string && data.get('organization', '').size() <= 256);
    }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'ownerId', 'createdAt', 'auditCount', 'modelType', 'useCase']) &&
             data.name is string && data.name.size() <= 100 &&
             data.ownerId == request.auth.uid &&
             data.auditCount is number &&
             data.modelType in ['classification', 'regression', 'ranking'] &&
             data.useCase in ['hiring', 'lending', 'content', 'other'] &&
             data.createdAt is timestamp;
    }

    function isValidAuditRun(data) {
      return data.keys().hasAll(['projectId', 'status', 'createdAt']) &&
             data.projectId is string &&
             data.status in ['queued', 'running', 'completed', 'failed'] &&
             data.createdAt is timestamp;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'organization']);
    }

    // 2. Projects Collection
    match /projects/{projectId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      allow create: if isEmailVerified() && isValidProject(incoming()) && 
                    incoming().createdAt == request.time && 
                    incoming().auditCount == 0;
      
      allow update: if isEmailVerified() && isOwner(existing().ownerId) && isValidProject(incoming()) && 
                    incoming().createdAt == existing().createdAt &&
                    incoming().ownerId == existing().ownerId && (
        // Action: Update details
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'modelType', 'useCase']) ||
        // Action: Increment audit count (Systemic update)
        incoming().diff(existing()).affectedKeys().hasOnly(['auditCount'])
      );
      
      allow delete: if isEmailVerified() && isOwner(existing().ownerId);

      // Audit Runs Subcollection
      match /audit_runs/{auditId} {
        // Master Gate: Verify parent project belongs to user
        function canAccessProject() {
          return get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        }

        allow list: if isSignedIn() && canAccessProject();
        allow get: if isSignedIn() && canAccessProject();
        
        allow create: if isEmailVerified() && canAccessProject() && isValidAuditRun(incoming()) && incoming().createdAt == request.time;
        
        allow update: if isEmailVerified() && canAccessProject() && isValidAuditRun(incoming()) && incoming().createdAt == existing().createdAt && (
          // System updates the status and report
          incoming().diff(existing()).affectedKeys().hasAny(['status', 'report', 'completedAt', 'error'])
        );
      }
    }
  }
}
