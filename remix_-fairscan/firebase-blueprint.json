{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "organization": { "type": "string" }
      },
      "required": ["email", "fullName"]
    },
    "Project": {
      "title": "Project",
      "description": "A compliance monitor project",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "modelType": { "type": "string", "enum": ["classification", "regression", "ranking"] },
        "useCase": { "type": "string", "enum": ["hiring", "lending", "content", "other"] },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "auditCount": { "type": "integer" }
      },
      "required": ["name", "ownerId", "createdAt", "auditCount"]
    },
    "AuditRun": {
      "title": "AuditRun",
      "description": "A specific audit execution log",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "running", "completed", "failed"] },
        "modelName": { "type": "string" },
        "datasetRows": { "type": "integer" },
        "datasetColumns": { "type": "integer" },
        "labelColumn": { "type": "string" },
        "predictionColumn": { "type": "string" },
        "sensitiveFeatures": { "type": "array", "items": { "type": "string" } },
        "decisionThreshold": { "type": "number" },
        "report": { "type": "object" },
        "error": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "status", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "projects/{projectId}": {
      "schema": "Project",
      "description": "Compliance projects"
    },
    "projects/{projectId}/audit_runs/{auditId}": {
      "schema": "AuditRun",
      "description": "Audit runs for a project"
    }
  }
}
